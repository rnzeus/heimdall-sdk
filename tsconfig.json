{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "types": [],
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@utils": ["src/utils/index.ts"],
      "@types": ["src/types/index.ts"],
      "@public/*": ["src/public/*"]
    }
  },
  "include": ["src"]
}

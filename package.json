{
  "name": "@rnzeus/heimdall-sdk",
  "version": "0.2.4",
  "description": "React Native client for Heimdall — a desktop debug inspector for network, WebSocket, Zustand and console",
  "license": "MIT",
  "author": "Volodymyr Dudkevych",
  "homepage": "https://heimdall.rnzeus.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnzeus/heimdall-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rnzeus/heimdall-sdk/issues"
  },
  "keywords": [
    "react-native",
    "debugging",
    "devtools",
    "inspector",
    "network",
    "websocket",
    "zustand",
    "heimdall"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "zustand"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zustand": {
      "types": "./zustand/index.d.ts",
      "react-native": "./zustand/index.js",
      "import": "./zustand/index.js",
      "require": "./zustand/index.js",
      "default": "./zustand/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "node scripts/write-version.mjs && yarn clean && tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs dist",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "node scripts/write-version.mjs && tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "dupes": "jscpd"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-mmkv": ">=3",
    "react-native-tcp-socket": ">=6",
    "zustand": ">=3"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    }
  },
  "dependencies": {
    "@rnzeus/heimdall-protocol": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.12",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "react": "^18.3.1",
    "react-native": "^0.79.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-tcp-socket": "^6.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.2",
    "zustand": "^4.0.0"
  },
  "packageManager": "yarn@4.6.0",
  "volta": {
    "node": "22.14.0",
    "yarn": "4.6.0"
  }
}

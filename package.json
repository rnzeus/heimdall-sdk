{
  "name": "@rnzeus/heimdall-sdk",
  "version": "0.1.19",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "zustand"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zustand": {
      "types": "./zustand/index.d.ts",
      "react-native": "./zustand/index.js",
      "import": "./zustand/index.js",
      "require": "./zustand/index.js",
      "default": "./zustand/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs dist && node scripts/minify-dist.mjs dist",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "axios": ">=1.8.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-mmkv": ">=3",
    "react-native-tcp-socket": ">=6",
    "zustand": ">=3"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    },
    "axios": {
      "optional": true
    }
  },
  "dependencies": {
    "@rnzeus/heimdall-protocol": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.12",
    "axios": "^1.8.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-native": "^0.79.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-tcp-socket": "^6.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.2",
    "zustand": "^4.0.0"
  }
}

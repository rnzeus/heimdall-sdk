{
  "name": "@rnzeus/heimdall-sdk",
  "version": "0.1.7",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "zustand.js",
    "zustand.d.ts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zustand": {
      "types": "./dist/zustand/index.d.ts",
      "react-native": "./dist/zustand/index.js",
      "default": "./dist/zustand/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup && tsc -p tsconfig.types.json",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-mmkv": ">=3",
    "react-native-tcp-socket": ">=6",
    "zustand": ">=3"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    }
  },
  "dependencies": {
    "@rnzeus/heimdall-protocol": "^0.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-native": "^0.79.0",
    "zustand": "^4.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2",
    "react-native-tcp-socket": "^6.3.0",
    "react-native-mmkv": "^3.3.0"
  }
}
